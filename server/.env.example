# emous Backend Environment Configuration
PORT=4000
# Provide a MongoDB Atlas URI in production. If omitted locally, emous automatically boots an embedded MongoDB instance with seed data!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/emous?retryWrites=true&w=majority

# Web App public URL used to format inbox links (e.g., emous.app/ask/GoldenWizard)
PUBLIC_DOMAIN=emous.app

# Optional Unsplash Access Key for live photo search/shuffling (falls back to curated high-energy Unsplash pack if omitted)
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key
